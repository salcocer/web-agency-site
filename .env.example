# Copy to .env.local and fill in. Never commit real keys.

# Public address of the site, used in sign-in emails and Stripe redirects.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase: Project Settings → API Keys
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_SECRET_KEY=sb_secret_...

# Stripe: Developers → API keys. Use test keys until launch.
STRIPE_SECRET_KEY=sk_test_...
# Locally: printed by `npm run stripe:listen`. In production: the webhook endpoint's signing secret.
STRIPE_WEBHOOK_SECRET=whsec_...
# Printed by `npm run stripe:setup`.
STRIPE_PORTAL_CONFIGURATION_ID=
